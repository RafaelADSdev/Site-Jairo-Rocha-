---
import '../styles/brand-emblem-3d.css';
---
<div class="brand-emblem" data-brand-emblem data-brand-state="fallback">
  <div class="brand-emblem__stage" data-brand-stage>
    <div class="brand-emblem__fallback" data-brand-fallback aria-hidden="true">
      <img src="/images/logo.webp" width="186" height="67" alt="" data-brand-logo />
      <span class="brand-emblem__anniversary" data-brand-anniversary><b>40</b><small>anos</small></span>
    </div>
    <button class="brand-emblem__toggle" data-brand-toggle type="button" aria-label="Ativar logo completa em 3D" title="Ativar logo completa em 3D" disabled>
      <span class="brand-emblem__status" data-brand-label>Ativar logo completa em 3D</span>
    </button>
  </div>
  <span class="brand-emblem__status" data-brand-status role="status"></span>
</div>
<script>
  import {initBrandEmblems} from '../scripts/brand-emblem-3d';
  initBrandEmblems();
</script>
