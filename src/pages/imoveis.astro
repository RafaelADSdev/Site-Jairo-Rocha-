---
import Layout from '../layouts/Layout.astro';import Icon from '../components/Icon.astro';import PropertyCard from '../components/PropertyCard.astro';import {properties} from '../data/properties';
---
<Layout title="Encontre seu imóvel"><div class="container"><div class="breadcrumb"><a href="/">Início</a><span>/</span><span>Imóveis</span></div><div class="page-title"><h1>Um lugar para os seus planos.</h1><p>Explore os endereços. Imagine as possibilidades. Encontre o seu.</p></div><form class="catalog-filters" id="filters"><label class="field">O que você procura?<select name="tipo"><option value="">Todos os imóveis</option><option value="novos">Novos</option><option value="seminovos">Seminovos</option><option value="locacao">Locação</option></select></label><div class="field" data-place-suggest><label for="place-catalog">Onde?</label><input id="place-catalog" name="local" placeholder="Cidade, bairro ou empreendimento"/></div><label class="field">Valor máximo<select name="valor"><option value="">Sem limite</option><option value="10000">R$ 10 mil</option><option value="500000">R$ 500 mil</option><option value="1000000">R$ 1 milhão</option><option value="2000000">R$ 2 milhões</option></select></label><button class="btn"><Icon name="search"/>Buscar</button></form><div class="catalog-meta"><span id="result-count">{properties.length} imóveis para descobrir</span><label>Ordenar por <select id="sort"><option value="default">Nossa seleção</option><option value="low">Menor preço</option><option value="high">Maior preço</option></select></label></div><section class="catalog-content"><div class="property-grid" id="results">{properties.map(p=><PropertyCard property={p}/>)}</div><div class="empty-state" id="empty" hidden><h2>Seu próximo lugar ainda está por aqui.</h2><p>Nenhum imóvel desta prévia corresponde a esses filtros. Experimente ampliar a busca.</p><button class="btn" id="clear">Limpar filtros</button></div><p class="demo-note">Seleção demonstrativa baseada no catálogo público. Preços e disponibilidade precisam ser confirmados com a equipe.</p></section></div>
<script>
 const form=document.querySelector<HTMLFormElement>('#filters')!;const params=new URLSearchParams(location.search);['tipo','local','valor'].forEach(k=>{const el=form.elements.namedItem(k) as HTMLInputElement;el.value=params.get(k)||''});
 const cards=[...document.querySelectorAll<HTMLElement>('.property-card')];const normalize=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
 function filter(){const data=new FormData(form);const type=String(data.get('tipo')||'');const place=normalize(String(data.get('local')||''));const max=Number(data.get('valor')||0);let count=0;cards.forEach(c=>{const price=Number(c.dataset.price);const matches=(!type||c.dataset.category===type)&&(!place||normalize(c.textContent||'').includes(place))&&(!max||(price>0&&price<=max));c.hidden=!matches;if(matches)count++});document.querySelector('#result-count')!.textContent=`${count} ${count===1?'imóvel para descobrir':'imóveis para descobrir'}`;document.querySelector<HTMLElement>('#empty')!.hidden=count>0;const query=new URLSearchParams();data.forEach((v,k)=>{if(v)query.set(k,String(v))});history.replaceState(null,'','/imoveis'+(query.size?'?'+query:''))}
 form.addEventListener('submit',e=>{e.preventDefault();filter()});form.addEventListener('input',()=>filter());document.querySelector('#clear')?.addEventListener('click',()=>{form.reset();filter()});document.querySelector('#sort')?.addEventListener('change',e=>{const value=(e.target as HTMLSelectElement).value;const sorted=[...cards];if(value!=='default')sorted.sort((a,b)=>{const pa=Number(a.dataset.price)||Infinity,pb=Number(b.dataset.price)||Infinity;if(pa===Infinity)return 1;if(pb===Infinity)return -1;return value==='low'?pa-pb:pb-pa});sorted.forEach(c=>document.querySelector('#results')!.append(c))});filter();
</script>
<script>
  import '../scripts/place-suggest';
</script></Layout>
