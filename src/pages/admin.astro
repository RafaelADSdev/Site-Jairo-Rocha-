---
import Layout from '../layouts/Layout.astro';import Icon from '../components/Icon.astro';import {properties,money} from '../data/properties';import {sized} from '../lib/image';
const peCoast = properties.filter(p => p.coast && p.state !== 'AL').length;
---
<Layout title="Gestão de imóveis — demonstração"><div class="admin-shell"><aside class="admin-sidebar" aria-label="Painel"><strong class="admin-sidebar-title">Seu portfólio.</strong><a class="active" href="/admin"><Icon name="book" size={17}/>Imóveis</a><a href="/admin/novo"><Icon name="plus" size={17}/>Novo imóvel</a><a href="/" ><Icon name="diagonal" size={17}/>Visualizar site</a><p>Ambiente de apresentação.<br/>Sem autenticação ou publicação real.</p></aside><div class="admin-content"><div class="admin-heading"><div><h1>Imóveis</h1><p>Organize os endereços que vão começar novas histórias.</p></div><a class="btn" href="/admin/novo"><Icon name="plus" size={17}/>Novo imóvel</a></div><div class="admin-stats"><div><strong>{properties.length}</strong><span>Imóveis na demonstração</span></div><div><strong>3</strong><span>Destaques na home</span></div><div><strong>{peCoast}</strong><span>Imóveis no litoral</span></div></div><div class="table-wrap"><table><thead><tr><th>Imóvel</th><th>Categoria</th><th>Valor</th><th>Status da prévia</th><th>Ações</th></tr></thead><tbody>{properties.map(p=><tr><td><img src={sized(p.image,{width:130,height:96})} alt="" width="65" height="48" loading="lazy"/><div><strong>{p.name}</strong><small>{p.location}</small></div></td><td data-label="Categoria">{p.label}</td><td data-label="Valor">{money(p.price)}</td><td data-label="Status"><span class="status">Visível na prévia</span></td><td><a class="text-link" href={`/admin/novo?editar=${p.slug}`}>Editar<span class="sr-only"> {p.name}</span></a></td></tr>)}</tbody></table></div><p class="demo-note">Prévia do painel administrativo. Os números representam apenas os imóveis deste mockup. Alterações nesta apresentação não publicam conteúdo no site real.</p></div></div></Layout>
