---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PropertyCard from '../components/PropertyCard.astro';
import {properties} from '../data/properties';
import HomeOpening from '../components/HomeOpening.astro';
import {destinations, type DestinationKey} from '../data/litoral-simulator';

// Cada destino abre o simulador do litoral já configurado para ele.
const coastDestinations: DestinationKey[] = ['porto', 'muro', 'carneiros', 'tamandare'];
---
<Layout home>
<HomeOpening />
<section class="section container home-list" id="enderecos"><div class="section-heading"><div><h2>Endereços que merecem<br/>a sua atenção.</h2><p>Uma seleção para inspirar o seu próximo passo.</p></div><button class="text-link" type="button" data-show-all aria-expanded="false" aria-controls="home-properties"><span data-show-all-label>Ver todos os imóveis</span> <Icon name="arrow"/></button></div><div class="property-grid" id="home-properties">{properties.map((p,i)=><PropertyCard property={p} extra={i>=3}/>)}</div></section>
<section class="coast-section"><div class="container coast-layout"><div class="coast-copy"><h2>O mar muda<br/>a sua perspectiva.<br/><em>E os seus planos.</em></h2><p>Descubra as possibilidades do litoral pernambucano. Um refúgio para os seus dias. Um novo horizonte para investir.</p><a class="btn btn-cream" href="/litoral">Encontre seu lugar ao sol <Icon name="diagonal"/></a><a class="coast-sim" href="/litoral#simulador">Quanto pode render um imóvel no litoral? <Icon name="arrow" size={18}/></a></div><div class="coast-image"><img src="/images/marine.jpg" width="1024" height="576" alt="Piscinas e jardins do La Fleur Polinésia" loading="lazy"/><div class="coast-image-caption"><span>La Fleur Polinésia<small>Porto de Galinhas · PE</small></span><a href="/imovel/la-fleur-polinesia" class="round-link" aria-label="Conhecer La Fleur Polinésia"><Icon name="diagonal"/></a></div></div></div><div class="container destination-links">{coastDestinations.map(key=><a href={`/litoral?destino=${key}#simulador`}>{destinations[key].label} <Icon name="diagonal" size={17}/></a>)}</div></section>
<section class="section container story-section"><div class="story-mark"><span>40</span><i>anos de histórias.</i></div><div class="story-copy"><h2>Os endereços mudam.<br/>A confiança permanece.</h2><p>Desde 1986, a Jairo Rocha faz parte das escolhas de quem quer viver Pernambuco. Agora, uma nova experiência para aproximar você do seu próximo imóvel.</p><a class="text-link" href="/sobre">Conheça a nossa história <Icon name="arrow"/></a></div></section>
</Layout>
<script>
  import '../scripts/place-suggest';
  import '../scripts/home-list';
</script>
