---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import SoproImage from '../components/SoproImage.astro';
import {money} from '../data/properties';
import {sopro} from '../data/sopro';
import {existsSync} from 'node:fs';
import {resolve} from 'node:path';

const hasModel = existsSync(resolve('public/models/sopro-v2.glb'));
const {occupancy, occupancySource, occupancyLabel} = sopro.investment;
const shotIndex = (caption: string) => sopro.photos.findIndex((photo) => photo.caption === caption);
const shot = (caption: string) => sopro.photos[shotIndex(caption)];
const featuredCaptions = [
  'Vista aérea',
  'Entrada',
  'Acesso',
  'Recepção',
  'Parque aquático',
  'Praia do Sopro',
  'Piscina e bar',
  'Deck',
  'Apartamento',
  'Quarto',
  'Living',
  'Varanda gourmet',
  'Spa',
  'Restaurante'
];
const morePhotos = sopro.photos.filter((photo) => !featuredCaptions.includes(photo.caption));
---
<Layout title="Sopro" overlay>
<section class="sopro-hero">
  <SoproImage src="/images/sopro/aereo.webp" width={1920} height={1080} sizes="100vw" alt="Vista aérea da Praia do Toque, com coqueiral, faixa de areia e o mar de São Miguel dos Milagres." loading="eager" fetchpriority="high"/>
  <div class="sopro-hero-shade"></div>
  <div class="container sopro-hero-copy">
    <h1>Sopro.<br/>A praia sentida<br/>em <em>cada detalhe.</em></h1>
    <p>Praia do Toque, São Miguel dos Milagres, AL. {sopro.units} unidades com piscina privativa e uma prainha só do empreendimento.</p>
    <div class="sopro-hero-actions">
      <button class="btn btn-cream" data-chat-open>Quero conhecer o Sopro <Icon name="arrow"/></button>
      <a class="hero-link" href="#espacos">Ver os espaços <span><Icon name="plus" size={16}/></span></a>
    </div>
    <nav class="sopro-jump" aria-label="Nesta página">
      <a href="#espacos">Espaços</a>
      <a href="#tipologias">Plantas</a>
      <a href="#implantacao">Implantação</a>
      <a href="#entorno">Entorno</a>
      <a href="#numeros">Números</a>
      <a href="#modelo">3D</a>
    </nav>
  </div>
</section>

<section class="sopro-spaces" id="espacos">
  <div class="container">
    <div class="sopro-spaces-head">
      <h2>Os espaços.</h2>
      <p>Piscina privativa, prainha, restaurante, spa e recepção. Fotografias oficiais do empreendimento.</p>
    </div>

    <button type="button" class="sopro-plate sopro-plate--lead" data-sopro-photo={shotIndex('Vista aérea')} aria-label="Ampliar: Vista aérea">
      <span class="sopro-shot-frame">
        <SoproImage {...shot('Vista aérea')} sizes="(max-width: 780px) calc(100vw - 40px), min(1280px, calc(100vw - 112px))" loading="eager"/>
      </span>
      <span class="sopro-shot-name">Vista aérea</span>
    </button>

    <div class="sopro-spread">
      <article class="sopro-folio">
        <h3>A praia não é só vista.<br/><em>É sentida.</em></h3>
        <p>{sopro.spreads[0].text}</p>
      </article>
      <div class="sopro-spread-frame">
        {['Entrada', 'Acesso', 'Recepção'].map((caption) => (
          <button type="button" class="sopro-shot" data-sopro-photo={shotIndex(caption)} aria-label={`Ampliar: ${caption}`}>
            <span class="sopro-shot-frame">
              <SoproImage {...shot(caption)} sizes="(max-width: 780px) calc(50vw - 26px), 48vw"/>
            </span>
            <span class="sopro-shot-name">{caption}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="sopro-cluster">
      <div class="sopro-spread sopro-spread--water">
        <button type="button" class="sopro-plate sopro-plate--flush" data-sopro-photo={shotIndex('Parque aquático')} aria-label="Ampliar: Parque aquático">
          <span class="sopro-shot-frame">
            <SoproImage {...shot('Parque aquático')} sizes="(max-width: 780px) calc(100vw - 40px), 62vw"/>
          </span>
          <span class="sopro-shot-name">Parque aquático</span>
        </button>
        <article class="sopro-folio">
          <h3>Praia do <em>Sopro.</em></h3>
          <p>{sopro.spreads[1].text}</p>
        </article>
      </div>
      <div class="sopro-trio">
        {['Praia do Sopro', 'Piscina e bar', 'Deck'].map((caption) => (
          <button type="button" class="sopro-shot" data-sopro-photo={shotIndex(caption)} aria-label={`Ampliar: ${caption}`}>
            <span class="sopro-shot-frame">
              <SoproImage {...shot(caption)} sizes="(max-width: 780px) calc(50vw - 26px), 32vw"/>
            </span>
            <span class="sopro-shot-name">{caption}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="sopro-cluster">
      <div class="sopro-spread sopro-spread--live">
        <article class="sopro-folio">
          <h3>120 unidades.<br/><em>29,2 m² e 34,2 m².</em></h3>
          <p>{sopro.spreads[3].text}</p>
        </article>
        <button type="button" class="sopro-plate sopro-plate--flush sopro-plate--room" data-sopro-photo={shotIndex('Apartamento')} aria-label="Ampliar: Apartamento">
          <span class="sopro-shot-frame">
            <SoproImage {...shot('Apartamento')} sizes="(max-width: 780px) calc(100vw - 40px), 62vw"/>
          </span>
          <span class="sopro-shot-name">Apartamento</span>
        </button>
      </div>
      <div class="sopro-rooms">
        {['Quarto', 'Living', 'Varanda gourmet'].map((caption) => (
          <button type="button" class:list={['sopro-shot', {'sopro-shot--portrait': shot(caption).portrait}]} data-sopro-photo={shotIndex(caption)} aria-label={`Ampliar: ${caption}`}>
            <span class="sopro-shot-frame">
              <SoproImage {...shot(caption)} sizes="(max-width: 780px) calc(50vw - 26px), 38vw"/>
            </span>
            <span class="sopro-shot-name">{caption}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="sopro-spread sopro-spread--late">
      <button type="button" class="sopro-plate sopro-plate--flush" data-sopro-photo={shotIndex('Spa')} aria-label="Ampliar: Spa">
        <span class="sopro-shot-frame">
          <SoproImage {...shot('Spa')} sizes="(max-width: 780px) calc(100vw - 40px), 62vw"/>
        </span>
        <span class="sopro-shot-name">Spa</span>
      </button>
      <article class="sopro-folio">
        <h3><em>Late Checkout.</em></h3>
        <p>{sopro.spreads[2].text}</p>
      </article>
    </div>

    <button type="button" class="sopro-plate sopro-plate--wide" data-sopro-photo={shotIndex('Restaurante')} aria-label="Ampliar: Restaurante">
      <span class="sopro-shot-frame">
        <SoproImage {...shot('Restaurante')} sizes="(max-width: 780px) calc(100vw - 40px), min(1280px, calc(100vw - 112px))"/>
      </span>
      <span class="sopro-shot-name">Restaurante</span>
    </button>

    <div class="sopro-index">
      {morePhotos.map((photo) => (
        <button type="button" class:list={['sopro-shot', {'sopro-shot--portrait': photo.portrait}]} data-sopro-photo={shotIndex(photo.caption)} aria-label={`Ampliar: ${photo.caption}`}>
          <span class="sopro-shot-frame">
            <SoproImage {...photo} sizes="(max-width: 780px) calc(50vw - 26px), 24vw"/>
          </span>
          <span class="sopro-shot-name">{photo.caption}</span>
        </button>
      ))}
    </div>

    <ul class="sopro-leisure">
      {sopro.leisure.map((item) => <li>{item}</li>)}
    </ul>
    <p class="demo-note sopro-spaces-note">Imagens oficiais do projeto. Perspectivas ilustrativas, sujeitas a alterações na execução.</p>
  </div>
</section>

<section class="sopro-types" id="tipologias">
  <div class="container">
    <div class="sopro-types-head">
      <div>
        <h2>Dois jeitos de<br/>viver o Sopro.</h2>
        <p>Compare as plantas do térreo com garden e do pavimento superior. Em ambas, a piscina e a varanda gourmet fazem parte da experiência.</p>
      </div>
      <p class="sopro-types-source">Plantas do book oficial<br/>páginas 35 e 39</p>
    </div>
    <div class="sopro-type-grid">
      {sopro.typologies.map((type) => (
        <article class="sopro-type" data-sopro-type={type.id}>
          <div class="sopro-type-heading">
            <span>{type.id === 'terreo' ? 'PAVIMENTO TÉRREO' : 'PAVIMENTO SUPERIOR'}</span>
            <div>
              <h3>{type.name}</h3>
              <strong>{type.area}</strong>
            </div>
          </div>
          <figure>
            <SoproImage
              src={type.plan}
              alt={type.planAlt}
              width={type.planWidth}
              height={type.planHeight}
              sizes="(max-width: 780px) calc(100vw - 40px), calc(50vw - 70px)"
            />
            <figcaption>Planta oficial · book, página {type.bookPage}</figcaption>
          </figure>
          <ul>
            {type.features.map((feature) => <li>{feature}</li>)}
          </ul>
        </article>
      ))}
    </div>
    <p class="demo-note sopro-types-note">As plantas identificam áreas arredondadas de 34 m² e 29 m². O cadastro comercial informa 34,2 m² e 29,2 m². Confirme área privativa, disponibilidade e alterações de projeto na documentação da unidade.</p>
  </div>
</section>

<section class="sopro-plan" id="implantacao">
  <div class="container">
    <div class="sopro-plan-head">
      <h2>A implantação.</h2>
      <p>Três ruas de unidades, o lazer no centro e a praia à esquerda. O desenho do condomínio na Praia do Toque.</p>
    </div>
    <button type="button" class="sopro-plan-shot" data-sopro-photo={sopro.photos.length} aria-label="Ampliar a implantação do Sopro">
      <SoproImage {...sopro.plan} sizes="(max-width: 780px) calc(100vw - 88px), min(1180px, calc(100vw - 160px))"/>
      <span>{sopro.plan.caption}</span>
    </button>
    <p class="demo-note">Planta de implantação oficial. Áreas e paisagismo ilustrativos do projeto.</p>
  </div>
</section>
<dialog class="lightbox" id="sopro-gallery" aria-label="Galeria do Sopro">
  <button class="icon-btn" id="sopro-gallery-close" aria-label="Fechar fotografia"><Icon name="close"/></button>
  <img id="sopro-gallery-photo" src={sopro.photos[0].src} alt={sopro.photos[0].alt}/>
  <div class="gallery-controls">
    <button type="button" id="sopro-prev">Anterior</button>
    <span id="sopro-photo-counter">1 / {sopro.photos.length + 1}</span>
    <button type="button" id="sopro-next">Seguinte</button>
  </div>
  <p id="sopro-gallery-caption">{sopro.photos[0].caption}</p>
</dialog>

<section class="sopro-place" id="entorno">
  <div class="container">
    <div class="sopro-place-head">
      <h2>O que o Toque<br/>coloca ao alcance.</h2>
      <p>Distâncias aproximadas a partir da Praia do Toque, na Rota Ecológica de Alagoas. Confirme o trajeto no mapa.</p>
    </div>
    <div class="sopro-place-layout">
      <ol class="sopro-nearby">
        {sopro.nearby.map((place) => (
          <li>
            <strong>{place.name}</strong>
            <span>{place.detail}</span>
            <small>{place.distance}</small>
          </li>
        ))}
      </ol>
      <div class="sopro-map">
        <iframe title="Sopro na Praia do Toque, São Miguel dos Milagres" src={sopro.embed} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        <a class="text-link" href={sopro.maps} target="_blank" rel="noreferrer">Abrir no Google Maps <Icon name="diagonal" size={16}/></a>
        <p class="demo-note">{sopro.address}</p>
      </div>
    </div>
  </div>
</section>

<section class="sopro-yield" id="numeros">
  <div class="sopro-proof">
    <div class="container sopro-proof-layout">
      <div class="sopro-proof-copy">
        <h2>Um verdadeiro paraíso<br/><em>para investir.</em></h2>
        <p class="sopro-proof-lead">O Sopro é muito mais do que um empreendimento de praia. É conquistar o privilégio de investir onde todos sonham passar férias.</p>
      </div>
      <div class="sopro-proof-figure">
        <SoproImage src="/images/sopro/ocupacao.webp" width={910} height={648} sizes="(max-width: 780px) calc(100vw - 40px), 47vw" alt="Vista aérea da Praia do Toque, com coqueiral, faixa de areia e o mar."/>
        <p class="sopro-proof-stat">
          <strong>{occupancy}<span>%</span></strong>
          <b>{occupancyLabel}</b>
        </p>
      </div>
      <div class="sopro-proof-side">
        <SoproImage src="/images/sopro/toque-entrada.webp" width={446} height={644} sizes="(max-width: 780px) calc(50vw - 26px), 18vw" alt="Placa de bem-vindo na Praia do Toque, sob uma árvore."/>
        <SoproImage src="/images/sopro/toque-orla.webp" width={446} height={646} sizes="(max-width: 780px) calc(50vw - 26px), 18vw" alt="Orla da Praia do Toque, com ondas na areia e céu aberto."/>
      </div>
      <p class="demo-note sopro-proof-note">* Dados da {occupancySource}. Média do destino; não é garantia de ocupação ou renda da unidade.</p>
    </div>
  </div>
</section>

<section class="sopro-stage" id="modelo">
  <div class="container">
    <div class="sopro-stage-head">
      <h2>Explore um bloco do Sopro.</h2>
      <p>Comece pelo exterior e aproxime o olhar do térreo ou do pavimento superior. O modelo otimizado de 1,9 MB só é carregado quando você escolhe explorar.</p>
    </div>
    {hasModel ? (
      <div class="sopro-viewer" id="sopro-viewer" data-model-state="idle" aria-busy="false">
        <div class="sopro-model-cover">
          <SoproImage
            src="/images/sopro/galeria-04.webp"
            width={1920}
            height={1072}
            sizes="(max-width: 780px) calc(100vw - 40px), min(1280px, calc(100vw - 112px))"
            alt="Vista aérea do Sopro usada como capa para a experiência em 3D"
          />
          <span class="sopro-model-shade"></span>
          <div class="sopro-model-cover-copy">
            <Icon name="cube" size={34}/>
            <strong>Explore o bloco em 3D</strong>
            <span>Carregamento sob demanda · 1,9 MB</span>
            <button class="btn btn-cream" type="button" id="sopro-model-load">Abrir experiência 3D <Icon name="arrow" size={17}/></button>
          </div>
        </div>
        <div class="sopro-model-host" id="sopro-model-host" hidden>
          <div class="sopro-model-canvas" id="sopro-model-canvas"></div>
          <div class="sopro-model-topbar">
            <span class="sopro-model-live"><i aria-hidden="true"></i> Representação interativa</span>
            <button class="sopro-model-fullscreen" type="button" id="sopro-model-fullscreen" aria-label="Ver em tela cheia" aria-pressed="false">
              <Icon name="maximize" size={18}/><span>Tela cheia</span>
            </button>
          </div>
          <div class="sopro-model-guide">
            <div class="sopro-model-tabs" role="tablist" aria-label="Vistas do modelo 3D">
              <button type="button" role="tab" aria-selected="true" tabindex="0" aria-controls="sopro-model-canvas" data-model-view-button="exterior">Exterior</button>
              <button type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls="sopro-model-canvas" data-model-view-button="terreo">Térreo</button>
              <button type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls="sopro-model-canvas" data-model-view-button="superior">Superior</button>
            </div>
            <div class="sopro-model-view-copy" aria-live="polite">
              <small data-model-view-label>Vista arquitetônica</small>
              <strong data-model-view-title>Bloco completo</strong>
              <p data-model-view-copy>Duas unidades por pavimento, piscinas privativas e a área externa do conjunto.</p>
            </div>
            <p class="sopro-model-gesture"><Icon name="cube" size={17}/><span><strong>Arraste para girar.</strong> Use dois dedos ou a roda para aproximar.</span></p>
          </div>
        </div>
        <div class="sopro-model-loading" role="status" aria-live="polite" hidden>
          <span class="sopro-model-spinner" aria-hidden="true"></span>
          <strong>Preparando o Sopro em 3D</strong>
          <div class="sopro-model-progress" role="progressbar" aria-label="Carregamento do modelo 3D" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
          <span data-model-progress-copy>Carregando o visualizador e o modelo…</span>
        </div>
        <div class="sopro-model-error" role="alert" hidden>
          <Icon name="cube" size={38}/>
          <h3>O 3D não carregou desta vez.</h3>
          <p>Você ainda pode conhecer a implantação completa ou tentar carregar o modelo novamente.</p>
          <div>
            <button class="btn btn-cream" type="button" id="sopro-model-retry">Tentar novamente</button>
            <a class="text-link" href="#implantacao">Ver a implantação</a>
          </div>
        </div>
        <noscript><p class="sopro-model-noscript">Ative o JavaScript para explorar o modelo 3D. A <a href="#implantacao">implantação completa</a> continua disponível.</p></noscript>
      </div>
    ) : (
      <div class="sopro-viewer sopro-viewer--empty">
        <Icon name="cube" size={48}/>
        <h3>O modelo ainda está a caminho.</h3>
        <p>Quando chegar, você gira, aproxima e percorre o bloco sem sair da página.</p>
      </div>
    )}
    <p class="demo-note">Representação 3D interativa baseada no material comercial. Elementos, dimensões e acabamentos sujeitos a confirmação.</p>
  </div>
</section>

<section class="sopro-close">
  <div class="container">
    <div class="sopro-close-card">
      <div>
        <small>Valor de referência</small>
        <strong>{money(sopro.priceFrom)}</strong>
        <p>A partir deste valor, sujeito a confirmação. {sopro.units} studios: 29,2&nbsp;m² no superior e 34,2&nbsp;m² no térreo, com garden. Piscina privativa em todas.</p>
      </div>
      <button class="btn" data-chat-open>Quero conhecer este imóvel <Icon name="arrow" size={18}/></button>
    </div>
  </div>
</section>
<script>
  const photos = [...document.querySelectorAll<HTMLButtonElement>('[data-sopro-photo]')];
  const gallery = document.querySelector<HTMLDialogElement>('#sopro-gallery');
  const galleryPhoto = document.querySelector<HTMLImageElement>('#sopro-gallery-photo');
  const galleryCaption = document.querySelector('#sopro-gallery-caption');
  const galleryCounter = document.querySelector('#sopro-photo-counter');
  let current = 0;
  const shotAt = (index: number) => photos.find((button) => Number(button.dataset.soproPhoto) === index) ?? photos[index];
  const show = (index: number) => {
    if (!photos.length || !galleryPhoto) return;
    current = (index + photos.length) % photos.length;
    const shot = shotAt(current);
    if (!shot) return;
    const img = shot.querySelector('img');
    if (img) {
      galleryPhoto.src = img.src;
      galleryPhoto.alt = img.alt;
    }
    if (galleryCaption) galleryCaption.textContent = shot.querySelector('.sopro-shot-name')?.textContent || '';
    if (galleryCounter) galleryCounter.textContent = `${current + 1} / ${photos.length}`;
  };
  photos.forEach((button) => button.addEventListener('click', () => {
    show(Number(button.dataset.soproPhoto));
    gallery?.showModal();
  }));
  document.querySelector('#sopro-prev')?.addEventListener('click', () => show(current - 1));
  document.querySelector('#sopro-next')?.addEventListener('click', () => show(current + 1));
  document.querySelector('#sopro-gallery-close')?.addEventListener('click', () => gallery?.close());
  gallery?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') show(current - 1);
    if (event.key === 'ArrowRight') show(current + 1);
  });
  const modelShell = document.querySelector<HTMLElement>('#sopro-viewer');
  const modelCover = modelShell?.querySelector<HTMLElement>('.sopro-model-cover');
  const modelHost = document.querySelector<HTMLElement>('#sopro-model-host');
  const modelCanvas = document.querySelector<HTMLElement>('#sopro-model-canvas');
  const modelLoading = modelShell?.querySelector<HTMLElement>('.sopro-model-loading');
  const modelError = modelShell?.querySelector<HTMLElement>('.sopro-model-error');
  const modelLoad = document.querySelector<HTMLButtonElement>('#sopro-model-load');
  const modelRetry = document.querySelector<HTMLButtonElement>('#sopro-model-retry');
  const modelFullscreen = document.querySelector<HTMLButtonElement>('#sopro-model-fullscreen');
  const modelProgress = modelShell?.querySelector<HTMLElement>('.sopro-model-progress');
  const modelProgressFill = modelProgress?.querySelector<HTMLElement>('span');
  const modelProgressCopy = modelShell?.querySelector<HTMLElement>('[data-model-progress-copy]');
  const modelViewLabel = modelShell?.querySelector<HTMLElement>('[data-model-view-label]');
  const modelViewTitle = modelShell?.querySelector<HTMLElement>('[data-model-view-title]');
  const modelViewCopy = modelShell?.querySelector<HTMLElement>('[data-model-view-copy]');
  const modelViewButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-model-view-button]')];
  let modelTimeout: ReturnType<typeof setTimeout> | undefined;
  let modelIsVisible = false;

  type ModelState = 'idle' | 'loading' | 'ready' | 'error';
  type ModelView = 'exterior' | 'terreo' | 'superior';
  const modelViews: Record<ModelView, {target: string; orbit: string; fieldOfView: string; label: string; title: string; copy: string}> = {
    exterior: {
      target: '1.2m 2.8m 0m',
      orbit: '90deg 67deg 28m',
      fieldOfView: '32deg',
      label: 'Vista arquitetônica',
      title: 'Bloco completo',
      copy: 'Duas unidades por pavimento, piscinas privativas e a área externa do conjunto.',
    },
    terreo: {
      target: '2.3m 1m 0m',
      orbit: '90deg 72deg 18m',
      fieldOfView: '30deg',
      label: 'Foco no térreo',
      title: 'Térreo com garden',
      copy: 'Duas unidades espelhadas, garden e piscinas privativas junto às varandas.',
    },
    superior: {
      target: '2.3m 4.1m 0m',
      orbit: '90deg 65deg 19m',
      fieldOfView: '30deg',
      label: 'Foco no superior',
      title: 'Pavimento superior',
      copy: 'Duas unidades espelhadas no primeiro andar, ambas com piscina e varanda gourmet.',
    },
  };
  const syncModelFocus = () => document.body.classList.toggle('sopro-model-active', modelIsVisible && modelShell?.dataset.modelState === 'ready');
  const setModelState = (state: ModelState) => {
    if (!modelShell || !modelCover || !modelHost || !modelLoading || !modelError) return;
    modelShell.dataset.modelState = state;
    modelShell.setAttribute('aria-busy', state === 'loading' ? 'true' : 'false');
    modelCover.hidden = state !== 'idle';
    modelHost.hidden = state === 'idle' || state === 'error';
    modelLoading.hidden = state !== 'loading';
    modelError.hidden = state !== 'error';
    syncModelFocus();
  };

  const failModel = () => {
    if (modelTimeout) clearTimeout(modelTimeout);
    modelCanvas?.replaceChildren();
    setModelState('error');
  };

  const applyModelView = (view: ModelView, focus = false) => {
    const model = document.querySelector<HTMLElement>('#sopro-model');
    const preset = modelViews[view];
    if (!model || !modelShell || !preset) return;
    modelShell.dataset.modelView = view;
    model.setAttribute('camera-target', preset.target);
    model.setAttribute('camera-orbit', preset.orbit);
    model.setAttribute('field-of-view', preset.fieldOfView);
    model.removeAttribute('auto-rotate');
    if (modelViewLabel) modelViewLabel.textContent = preset.label;
    if (modelViewTitle) modelViewTitle.textContent = preset.title;
    if (modelViewCopy) modelViewCopy.textContent = preset.copy;
    modelViewButtons.forEach((button) => {
      const selected = button.dataset.modelViewButton === view;
      button.setAttribute('aria-selected', String(selected));
      button.tabIndex = selected ? 0 : -1;
      if (selected && focus) button.focus();
    });
  };

  const updateModelProgress = (value: number) => {
    const percent = Math.max(0, Math.min(100, Math.round(value * 100)));
    modelProgress?.setAttribute('aria-valuenow', String(percent));
    if (modelProgressFill) modelProgressFill.style.transform = `scaleX(${percent / 100})`;
    if (modelProgressCopy) modelProgressCopy.textContent = percent > 0 ? `${percent}% carregado` : 'Carregando o visualizador e o modelo…';
  };

  const openModel = async () => {
    if (!modelCanvas || modelShell?.dataset.modelState === 'loading') return;
    setModelState('loading');
    modelCanvas.replaceChildren();
    updateModelProgress(0);

    try {
      await import('@google/model-viewer');
      const model = document.createElement('model-viewer');
      model.id = 'sopro-model';
      model.setAttribute('src', '/models/sopro-v2.glb');
      model.setAttribute('alt', 'Representação 3D de um bloco do Sopro com quatro unidades, piscinas privativas, escadas externas e paisagismo');
      model.setAttribute('camera-controls', '');
      model.setAttribute('touch-action', 'pan-y');
      model.setAttribute('shadow-intensity', '1.25');
      model.setAttribute('shadow-softness', '.8');
      model.setAttribute('exposure', '.95');
      model.setAttribute('interaction-prompt', 'auto');
      model.setAttribute('min-camera-orbit', 'auto auto 6m');
      model.setAttribute('max-camera-orbit', 'auto 88deg 38m');
      model.setAttribute('camera-target', modelViews.exterior.target);
      model.setAttribute('camera-orbit', modelViews.exterior.orbit);
      model.setAttribute('field-of-view', modelViews.exterior.fieldOfView);

      model.addEventListener('load', () => {
        if (modelTimeout) clearTimeout(modelTimeout);
        updateModelProgress(1);
        applyModelView('exterior');
        setModelState('ready');
      }, {once: true});
      model.addEventListener('progress', (event) => {
        const totalProgress = (event as CustomEvent<{totalProgress?: number}>).detail?.totalProgress ?? 0;
        updateModelProgress(totalProgress);
      });
      model.addEventListener('error', failModel, {once: true});
      modelCanvas.append(model);
      modelTimeout = setTimeout(failModel, 20_000);
    } catch {
      failModel();
    }
  };

  modelLoad?.addEventListener('click', openModel);
  modelRetry?.addEventListener('click', openModel);
  if (modelShell) {
    new IntersectionObserver(([entry]) => {
      modelIsVisible = entry.isIntersecting;
      syncModelFocus();
    }, {threshold: .45}).observe(modelShell);
  }
  modelViewButtons.forEach((button, index) => {
    button.addEventListener('click', () => applyModelView(button.dataset.modelViewButton as ModelView));
    button.addEventListener('keydown', (event) => {
      let next = index;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % modelViewButtons.length;
      else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + modelViewButtons.length) % modelViewButtons.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = modelViewButtons.length - 1;
      else return;
      event.preventDefault();
      applyModelView(modelViewButtons[next].dataset.modelViewButton as ModelView, true);
    });
  });
  modelFullscreen?.addEventListener('click', async () => {
    if (!modelShell || !document.fullscreenEnabled) return;
    if (document.fullscreenElement === modelShell) await document.exitFullscreen();
    else await modelShell.requestFullscreen();
  });
  document.addEventListener('fullscreenchange', () => {
    const active = document.fullscreenElement === modelShell;
    modelFullscreen?.setAttribute('aria-pressed', String(active));
    modelFullscreen?.setAttribute('aria-label', active ? 'Sair da tela cheia' : 'Ver em tela cheia');
    const label = modelFullscreen?.querySelector('span');
    if (label) label.textContent = active ? 'Sair da tela cheia' : 'Tela cheia';
  });
</script>
</Layout>
