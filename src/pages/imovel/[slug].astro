---
import Layout from '../../layouts/Layout.astro';import Icon from '../../components/Icon.astro';import {properties,money} from '../../data/properties';
import media from '../../data/media.json';
import {sized} from '../../lib/image';
export function getStaticPaths() {
 return properties.filter(property => !property.flagshipHref).map(property => ({ params: { slug: property.slug }, props: { property } }));
}
const { property: p } = Astro.props;
const photos = (media as Record<string,{photos:string[]}>)[p.slug]?.photos || [p.image];
---
<Layout title={p.name}><div class="container"><div class="breadcrumb"><a href="/">Início</a><span>/</span><a href="/imoveis">Imóveis</a><span>/</span><span>{p.name}</span></div><div class="detail-title"><div><h1>{p.name}</h1><p><Icon name="pin" size={17}/>{p.location} · {p.label}</p></div><button class="text-link" id="share">Compartilhar imóvel <Icon name="diagonal" size={17}/></button></div><div class="detail-gallery"><img src={p.image} id="main-photo" alt={`Vista do ${p.name}`} width="1024" height="576" fetchpriority="high"/><div class="detail-side-image"><img src={photos[0]} alt={`Outra vista do ${p.name}`} width="1024" height="576"/><button class="btn gallery-open" id="gallery-open">Ampliar fotografia <Icon name="plus" size={17}/></button></div></div><div class="gallery-thumbnails" aria-label="Fotografias do empreendimento">{[p.image,...photos].map((photo,i)=><button data-photo={photo} aria-label={`Ver fotografia ${i+1}`} aria-pressed={i===0?"true":"false"}><img src={sized(photo,{width:200,height:140})} alt="" loading="lazy" width="100" height="70"/></button>)}</div><div class="detail-body"><section><div class="media-tabs" role="tablist" aria-label="Explore o empreendimento"><button role="tab" aria-selected="true" aria-controls="panel-fotos" id="tab-fotos" data-tab="fotos">Fotos</button><button role="tab" aria-selected="false" aria-controls="panel-video" id="tab-video" tabindex="-1" data-tab="video"><Icon name="play" size={17}/>Vídeo</button><button role="tab" aria-selected="false" aria-controls="panel-book" id="tab-book" tabindex="-1" data-tab="book"><Icon name="book" size={17}/>Book digital</button><button role="tab" aria-selected="false" aria-controls="panel-tour" id="tab-tour" tabindex="-1" data-tab="tour"><Icon name="cube" size={17}/>Tour 3D</button></div><div id="panel-fotos" role="tabpanel" aria-labelledby="tab-fotos"><h2>Imagine a sua vida aqui.</h2><p class="detail-description">{p.description}</p><div class="spec-large"><span><Icon name="bed"/>{p.beds} {p.beds===1?'quarto':'quartos'}</span><span><Icon name="car"/>{p.parking} {p.parking===1?'vaga':'vagas'}</span></div><button class="text-link" id="gallery-inline">Explorar fotografia <Icon name="plus" size={16}/></button><p class="demo-note">Fotografia do catálogo público. A galeria completa, plantas e informações técnicas serão inseridas pela equipe na versão final.</p></div>{[{id:'video',icon:'play',title:'Conheça cada ângulo.',text:'Aqui, o visitante poderá assistir ao vídeo oficial do empreendimento sem sair da página. O vídeo da construtora ainda não foi fornecido.'},{id:'book',icon:'book',title:'Todos os detalhes, no seu tempo.',text:'O book digital reunirá plantas, diferenciais e apresentação do empreendimento. O PDF oficial será disponibilizado pela equipe.'},{id:'tour',icon:'cube',title:'Entre. Explore. Imagine.',text:'Este espaço receberá a apresentação 3D interativa do empreendimento. O tour real será incorporado a partir do material da construtora.'}].map(t=><div id={`panel-${t.id}`} role="tabpanel" aria-labelledby={`tab-${t.id}`} hidden><div class="media-placeholder" hidden={t.id==='video'&&p.slug==='la-fleur-polinesia'}><Icon name={t.icon} size={35}/><h3>{t.title}</h3><p>{t.text}</p><p class="demo-note">Prévia de apresentação · material a fornecer</p></div>{t.id==='video'&&p.slug==='la-fleur-polinesia'&&<div><div class="video-preview" id="video-preview"><img src={p.image} alt="La Fleur Polinesia"/><button class="btn" id="load-video"><Icon name="play"/>Reproduzir filme</button></div><p class="demo-note">Player do YouTube carregado ao reproduzir. <a href="https://www.youtube.com/watch?v=1q2AyjnKdyY" target="_blank" rel="noreferrer">Abrir no YouTube</a></p></div>}</div>)}</section><aside class="contact-card"><small>{p.category==='locacao'?'Aluguel mensal de referência':'Valor de referência'}</small><strong>{money(p.price)}</strong><p>Um endereço chamou sua atenção? Vamos descobrir se ele combina com o que você procura.</p><button class="btn" data-chat-open>Quero conhecer este imóvel <Icon name="arrow" size={18}/></button>{p.coast&&<a class="text-link" href="/litoral#simulador" style="margin-top:22px">Simular investimento <Icon name="diagonal" size={16}/></a>}<div class="contact-person"><span class="assistant-avatar"><Icon name="chat"/></span><span>Conte com a Jairo Rocha<small>Do primeiro interesse ao próximo capítulo.</small></span></div><p class="demo-note">Valores e disponibilidade sujeitos a confirmação. Esta é uma apresentação visual.</p></aside></div></div><dialog class="lightbox" id="gallery"><button class="icon-btn" id="gallery-close" aria-label="Fechar fotografia"><Icon name="close"/></button><img id="lightbox-photo" src={p.image} alt={`Fotografia ampliada do ${p.name}`}/><div class="gallery-controls"><button id="previous-photo">Anterior</button><span id="photo-counter">1 / {photos.length+1}</span><button id="next-photo">Seguinte</button></div><p>{p.name} · Imagem do catálogo público</p></dialog>
<script>
 const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];function activate(b:HTMLButtonElement){tabs.forEach(t=>{const active=t===b;t.setAttribute('aria-selected',String(active));t.tabIndex=active?0:-1;document.getElementById('panel-'+t.dataset.tab)!.hidden=!active})}tabs.forEach((b,i)=>{b.addEventListener('click',()=>activate(b));b.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();const n=tabs[(i+(e.key==='ArrowRight'?1:tabs.length-1))%tabs.length];activate(n);n.focus()}})});
 const photoButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-photo]')];let currentPhoto=0;
 function showPhoto(index:number){currentPhoto=(index+photoButtons.length)%photoButtons.length;const src=photoButtons[currentPhoto].dataset.photo!;document.querySelector<HTMLImageElement>('#main-photo')!.src=src;document.querySelector<HTMLImageElement>('#lightbox-photo')!.src=src;photoButtons.forEach((b,i)=>b.setAttribute('aria-pressed',String(i===currentPhoto)));document.querySelector('#photo-counter')!.textContent=`${currentPhoto+1} / ${photoButtons.length}`}
 photoButtons.forEach((b,i)=>b.addEventListener('click',()=>showPhoto(i)));document.querySelector('#previous-photo')?.addEventListener('click',()=>showPhoto(currentPhoto-1));document.querySelector('#next-photo')?.addEventListener('click',()=>showPhoto(currentPhoto+1));
 document.querySelector('#load-video')?.addEventListener('click',()=>{const frame=document.createElement('iframe');frame.src='https://www.youtube.com/embed/1q2AyjnKdyY?autoplay=1';frame.title='Filme La Fleur Polinesia';frame.allow='autoplay; encrypted-media; picture-in-picture';frame.allowFullscreen=true;document.querySelector('#video-preview')!.replaceChildren(frame)});
 const gallery=document.querySelector<HTMLDialogElement>('#gallery')!;['gallery-open','gallery-inline'].forEach(id=>document.getElementById(id)?.addEventListener('click',()=>gallery.showModal()));document.querySelector('#gallery-close')?.addEventListener('click',()=>gallery.close());document.querySelector('#share')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(location.href);document.querySelector('#share')!.textContent='Link copiado'}catch{document.querySelector('#share')!.textContent='Copie o endereço na barra do navegador'}});
</script></Layout>
