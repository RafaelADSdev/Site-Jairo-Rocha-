---
import Layout from '../../layouts/Layout.astro';import Icon from '../../components/Icon.astro';import {properties} from '../../data/properties';
---
<Layout title="Cadastro de imóvel — demonstração"><div class="container section"><a class="text-link" href="/admin">Voltar aos imóveis</a><div class="page-title"><h1 id="form-title">Um novo endereço no portfólio.</h1><p>Veja como será a experiência de cadastrar um imóvel.</p></div><form id="property-form" class="admin-form"><label class="field">Nome do imóvel<input name="name" required maxlength="120" placeholder="Ex.: Nome do empreendimento"/></label><label class="field">Categoria<select name="category"><option value="novos">Novo</option><option value="seminovos">Seminovo</option><option value="locacao">Locação</option></select></label><label class="field">Localização<input name="location" required placeholder="Bairro, cidade"/></label><label class="field">Preço (R$)<input name="price" type="number" min="0" step="1" placeholder="0 para sob consulta"/></label><label class="field">Quartos<input name="beds" type="number" min="0" max="30" value="2" required/></label><label class="field">Vagas<input name="parking" type="number" min="0" max="30" value="1" required/></label><label class="field wide">Apresentação<textarea name="description" placeholder="Conte o que torna este imóvel especial."></textarea></label><div class="upload-zone wide"><Icon name="plus" size={28}/><p>Fotografias do imóvel</p><label>Escolher imagens para a prévia<input id="images" type="file" accept="image/*" multiple/></label><p id="file-count"></p></div><label class="field">Vídeo do empreendimento<input name="video" type="url" placeholder="https://…"/></label><label class="field">Link da apresentação 3D<input name="tour" type="url" placeholder="https://…"/></label><label class="field wide">Book do empreendimento<input name="book" type="file" accept="application/pdf"/></label><label class="wide"><input name="featured" type="checkbox"/> Exibir como destaque na página inicial</label><div class="admin-save wide"><button class="btn">Salvar na prévia <Icon name="check" size={17}/></button><p id="save-status" role="status"></p></div><p class="demo-note wide">Demonstração do formulário. Os dados e arquivos não são enviados nem persistidos; o salvamento apresenta apenas uma confirmação visual.</p></form></div><script define:vars={{properties}} is:inline>window.demoProperties=properties;</script><script>
 const form=document.querySelector<HTMLFormElement>('#property-form')!;const slug=new URLSearchParams(location.search).get('editar');const prop=(window as any).demoProperties.find((p:any)=>p.slug===slug);if(prop){document.querySelector('#form-title')!.textContent='Editar '+prop.name;['name','category','location','price','beds','parking','description'].forEach(key=>{(form.elements.namedItem(key) as HTMLInputElement).value=String(prop[key]??'')})}document.querySelector<HTMLInputElement>('#images')?.addEventListener('change',e=>{const n=(e.target as HTMLInputElement).files?.length||0;document.querySelector('#file-count')!.textContent=n?`${n} arquivo(s) selecionado(s), sem envio.`:''});form.addEventListener('submit',e=>{e.preventDefault();document.querySelector('#save-status')!.textContent='Prévia validada. Nenhum dado foi publicado.'});
</script></Layout>
