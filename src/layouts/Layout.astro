---
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '@fontsource/manrope/800.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import {socials} from '../data/contact';
const {title='Seu próximo capítulo começa aqui',home=false,overlay=false}=Astro.props;
const path=Astro.url.pathname.replace(/\/$/,'')||'/';
const over=home||overlay;
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#e4141a"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content="Conceito visual do novo portal Jairo Rocha Imóveis. Encontre seu próximo endereço em Pernambuco."/><title>{title} | Jairo Rocha</title><link rel="icon" href="/favicon.svg"/><script is:inline>if(!matchMedia('(prefers-reduced-motion: reduce)').matches){document.documentElement.classList.add('motion-on');addEventListener('DOMContentLoaded',()=>setTimeout(()=>document.querySelectorAll('.property-photo,.coast-image,.story-mark,.sopro-plate').forEach(el=>el.classList.add('is-in')),2400))}</script></head><body>
<a class="skip" href="#main">Pular para o conteúdo</a>
<header class:list={['site-header',{over}]}><div class="header-inner"><a href="/" class="brand" aria-label="Jairo Rocha, início"><img src="/images/logo.webp" width="186" height="67" alt="Jairo Rocha Imóveis"/><span class="anniversary"><b>40</b><small>anos</small></span></a><nav aria-label="Navegação principal" id="main-nav"><a href="/imoveis?tipo=novos">Novos</a><a href="/imoveis?tipo=seminovos">Seminovos</a><a href="/imoveis?tipo=locacao">Locação</a><a href="/sobre" aria-current={path==='/sobre'?'page':undefined}>Sobre</a><a href="/sopro" aria-current={path==='/sopro'?'page':undefined}>Sopro</a><a href="/litoral" aria-current={path==='/litoral'?'page':undefined}>Viva o litoral <Icon name="diagonal" size={14}/></a></nav><button class="header-contact btn" data-chat-open>Encontre comigo <Icon name="chat" size={17}/></button><button id="menu-toggle" class="icon-btn mobile-menu" aria-label="Abrir menu" aria-expanded="false" aria-controls="main-nav"><Icon name="menu"/></button></div></header>
<main id="main"><slot/></main>
<footer><div class="container footer-top"><div><a class="brand footer-brand" href="/"><img src="/images/logo.webp" width="186" height="67" alt="Jairo Rocha Imóveis"/></a><p>Há 40 anos, conectando pessoas<br/>a novos começos.</p></div><div><strong>Encontre seu lugar</strong><a href="/imoveis?tipo=novos">Imóveis novos</a><a href="/imoveis?tipo=seminovos">Seminovos</a><a href="/imoveis?tipo=locacao">Locação</a></div><div><strong>Explore</strong><a href="/sopro">Sopro</a><a href="/sobre">Sobre a Jairo Rocha</a><a href="/litoral">Litoral pernambucano</a><a href="/litoral#simulador">Simule seu investimento</a><button data-chat-open>Converse com a assistente</button></div><div><strong>Jairo Rocha</strong><a href="/admin">Área do administrador <Icon name="diagonal" size={14}/></a><button data-info="A experiência PWA fará parte da implementação do portal. Nesta apresentação, você está navegando pelo conceito visual.">O portal no seu celular <Icon name="phone" size={14}/></button></div></div><div class="container footer-bottom"><span>© 2026 Jairo Rocha Imóveis · CRECI 7883-J</span><nav class="footer-social" aria-label="Redes sociais">{socials.map((item)=><a href={item.href} target="_blank" rel="noreferrer" class="social-link" aria-label={`${item.name} da Jairo Rocha`}><Icon name={item.icon} size={16}/></a>)}</nav><span>Conceito visual · Dados do catálogo sujeitos a confirmação</span></div></footer>
<button class="chat-fab" data-chat-open aria-label="Abrir assistente de imóveis"><Icon name="spark" size={22}/><span>Vamos encontrar seu imóvel?</span><span class="online-dot"></span></button>
<dialog id="chat-dialog" class="chat-dialog"><div class="chat-head"><div class="assistant-avatar"><Icon name="spark"/></div><div><strong>Sua próxima história</strong><small>Assistente Jairo Rocha · demonstração</small></div><button class="icon-btn" data-chat-close aria-label="Fechar assistente"><Icon name="close"/></button></div><div class="chat-messages" id="chat-messages" aria-live="polite"><p class="message">Olá! Vamos encontrar um lugar que combine com você? Me conte: está buscando um imóvel para morar, alugar ou investir no litoral?</p></div><div class="chat-suggestions"><button data-chat-prompt="Quero conhecer o Sopro">Conhecer o Sopro</button><button data-chat-prompt="Quero morar no Recife">Morar no Recife</button><button data-chat-prompt="Quero investir no litoral">Investir no litoral</button><button data-chat-prompt="Quero alugar">Alugar um imóvel</button></div><form id="chat-form"><label class="sr-only" for="chat-input">Sua mensagem</label><input id="chat-input" placeholder="Conte o que você procura…" required maxlength="400"/><button class="btn" aria-label="Enviar mensagem"><Icon name="arrow"/></button></form><p class="chat-disclaimer">Prévia com respostas guiadas. Nenhuma mensagem é enviada.</p></dialog>
<dialog id="info-dialog" class="info-dialog"><button class="icon-btn" id="info-close" aria-label="Fechar"><Icon name="close"/></button><h2>Uma prévia do que vem aí.</h2><p id="info-text"></p><button class="btn" id="info-ok">Entendi <Icon name="check"/></button></dialog><div id="toast" role="status"></div>
<script>
 import '../scripts/motion';
 const chat=document.querySelector<HTMLDialogElement>('#chat-dialog')!;
 document.querySelectorAll('[data-chat-open]').forEach(el=>el.addEventListener('click',()=>chat.showModal()));
 document.querySelector('[data-chat-close]')?.addEventListener('click',()=>chat.close());
 const info=document.querySelector<HTMLDialogElement>('#info-dialog')!;
 document.querySelectorAll<HTMLElement>('[data-info]').forEach(el=>el.addEventListener('click',()=>{document.querySelector('#info-text')!.textContent=el.dataset.info!;info.showModal()}));
 ['info-close','info-ok'].forEach(id=>document.getElementById(id)?.addEventListener('click',()=>info.close()));
 document.querySelectorAll('dialog').forEach(d=>d.addEventListener('click',e=>{if(e.target===d){const r=d.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)d.close()}}));
 document.querySelector('#menu-toggle')?.addEventListener('click',e=>{const b=e.currentTarget as HTMLElement;const open=b.getAttribute('aria-expanded')!=='true';b.setAttribute('aria-expanded',String(open));document.querySelector('#main-nav')?.classList.toggle('open',open)});
 document.querySelectorAll<HTMLButtonElement>('.favorite').forEach(b=>b.addEventListener('click',()=>{const active=b.getAttribute('aria-pressed')!=='true';b.setAttribute('aria-pressed',String(active));const toast=document.querySelector('#toast')!;toast.textContent=active?'Adicionado aos favoritos desta prévia':'Removido dos favoritos';toast.classList.add('visible');setTimeout(()=>toast.classList.remove('visible'),2300)}));
 const send=(text:string)=>{const list=document.querySelector('#chat-messages')!;const user=document.createElement('p');user.className='message user';user.textContent=text;list.append(user);const reply=document.createElement('p');reply.className='message';const t=text.toLowerCase();let label='Explorar imóveis no Recife';let link='/imoveis';let answer='Nesta prévia, posso mostrar algumas opções do catálogo. No portal completo, a assistente vai considerar seu orçamento, região e preferências.';if(/sopro|milagre|toque|alagoas/.test(t)){answer='O Sopro é o lançamento-bandeira na Praia do Toque, em São Miguel dos Milagres. Fotos, entorno, números e o modelo 3D estão na página do empreendimento.';label='Conhecer o Sopro';link='/sopro'}else if(/litoral|praia|invest|carneiro/.test(t)){answer='Para explorar o litoral, conheça o Sopro, La Fleur Polinésia e Amura Carneiros. Você também pode testar um cenário de investimento antes de escolher.';label='Ver imóveis do litoral';link='/litoral'}else if(/alug|loca/.test(t)){answer='Vamos começar pelas opções de locação. O Edf. Nice, em Boa Viagem, está entre os imóveis desta demonstração.';label='Explorar locação';link='/imoveis?tipo=locacao'}else if(/\bsobre\b|nossa hist[oó]ria|a empresa/.test(t)){answer='Desde 1986, a Jairo Rocha acompanha quem escolhe viver Pernambuco. Nesta apresentação, o capítulo da casa está aberto.';label='Ler sobre a Jairo Rocha';link='/sobre'}reply.textContent=answer;const a=document.createElement('a');a.href=link;a.textContent=label+' →';reply.append(a);list.append(reply);list.scrollTop=list.scrollHeight};
 document.querySelector('#chat-form')?.addEventListener('submit',e=>{e.preventDefault();const input=document.querySelector<HTMLInputElement>('#chat-input')!;if(input.value.trim())send(input.value.trim());input.value=''});
 document.querySelectorAll<HTMLElement>('[data-chat-prompt]').forEach(b=>b.addEventListener('click',()=>send(b.dataset.chatPrompt!)));
</script></body></html>
