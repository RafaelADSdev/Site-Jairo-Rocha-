---
import Layout from '../layouts/Layout.astro';import Icon from '../components/Icon.astro';import PropertyCard from '../components/PropertyCard.astro';import {properties} from '../data/properties';import {priceScales, bedOptions} from '../data/filters';
---
<Layout title="Encontre seu imóvel"><div class="container"><div class="breadcrumb"><a href="/">Início</a><span>/</span><span>Imóveis</span></div><div class="page-title"><h1>Um lugar para os seus planos.</h1><p>Explore os endereços. Imagine as possibilidades. Encontre o seu.</p></div><form class="catalog-filters" id="filters"><label class="field">O que você procura?<select name="tipo"><option value="">Todos os imóveis</option><option value="novos">Novos</option><option value="seminovos">Seminovos</option><option value="locacao">Locação</option></select></label><div class="field" data-place-suggest><label for="place-catalog">Onde?</label><input id="place-catalog" name="local" placeholder="Cidade, bairro ou empreendimento"/></div><label class="field">Quartos<select name="quartos">{bedOptions.map(([value,text])=><option value={value}>{text}</option>)}</select></label><label class="field"><span data-price-label>{priceScales.venda.label}</span><select name="valor" data-price-select>{priceScales.venda.options.map(([value,text])=><option value={value}>{text}</option>)}</select></label><button class="btn"><Icon name="search"/>Buscar</button></form><div class="catalog-meta"><span id="result-count" role="status" aria-live="polite">{properties.length} imóveis para descobrir</span><label>Ordenar por <select id="sort"><option value="default">Nossa seleção</option><option value="low">Menor preço</option><option value="high">Maior preço</option></select></label></div><section class="catalog-content" aria-labelledby="results-heading"><h2 class="sr-only" id="results-heading">Imóveis encontrados</h2><div class="property-grid" id="results">{properties.map(p=><PropertyCard property={p}/>)}</div><div class="empty-state" id="empty" hidden><h2>Seu próximo lugar ainda está por aqui.</h2><p>Nenhum imóvel desta prévia corresponde a esses filtros. Experimente ampliar a busca.</p><button class="btn" id="clear">Limpar filtros</button></div><p class="demo-note">Seleção demonstrativa baseada no catálogo público. Preços e disponibilidade precisam ser confirmados com a equipe.</p></section></div>
<script>
 import {createPriceScale} from '../scripts/price-scale';
 const form=document.querySelector<HTMLFormElement>('#filters')!;
 const priceSelect=form.querySelector<HTMLSelectElement>('[data-price-select]')!;
 const applyScale=createPriceScale(priceSelect,form.querySelector<HTMLElement>('[data-price-label]')!);
 const sort=document.querySelector<HTMLSelectElement>('#sort')!;
 const results=document.querySelector<HTMLElement>('#results')!;
 const cards=[...document.querySelectorAll<HTMLElement>('.property-card')];
 const normalize=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();

 const params=new URLSearchParams(location.search);
 const initialType=params.get('tipo')||'';
 (form.elements.namedItem('tipo') as HTMLSelectElement).value=initialType;
 (form.elements.namedItem('local') as HTMLInputElement).value=params.get('local')||'';
 (form.elements.namedItem('quartos') as HTMLSelectElement).value=params.get('quartos')||'';
 applyScale(initialType,params.get('valor')||'');

 function filter(){
   const type=String(new FormData(form).get('tipo')||'');
   // A escala precisa ser trocada antes de ler o teto: uma faixa de venda não vale para aluguel.
   applyScale(type);
   const data=new FormData(form);
   const place=normalize(String(data.get('local')||''));
   const beds=Number(data.get('quartos')||0);
   const max=Number(priceSelect.value||0);
   let count=0;
   let onRequest=0;
   for(const card of cards){
     const price=Number(card.dataset.price);
     // Preço 0 é "Sob consulta": nunca cai fora de uma faixa, só é contado à parte.
     const withinRange=!max||price===0||price<=max;
     const matches=(!type||card.dataset.category===type)
       &&(!place||normalize(card.textContent||'').includes(place))
       &&(!beds||Number(card.dataset.beds)>=beds)
       &&withinRange;
     card.hidden=!matches;
     if(matches){count++;if(price===0)onRequest++}
   }
   const noun=count===1?'imóvel para descobrir':'imóveis para descobrir';
   document.querySelector('#result-count')!.textContent=`${count} ${noun}`+(onRequest?` · ${onRequest} sob consulta`:'');
   document.querySelector<HTMLElement>('#empty')!.hidden=count>0;
   const query=new URLSearchParams();
   data.forEach((v,k)=>{if(v)query.set(k,String(v))});
   history.replaceState(null,'','/imoveis'+(query.size?'?'+query:''));
 }

 function reorder(){
   const value=sort.value;
   const ordered=[...cards];
   if(value!=='default')ordered.sort((a,b)=>{
     // Nunca comparar aluguel mensal com preço de venda; locação ordena como bloco separado.
     const rentA=a.dataset.category==='locacao'?1:0;
     const rentB=b.dataset.category==='locacao'?1:0;
     if(rentA!==rentB)return rentA-rentB;
     const pa=Number(a.dataset.price)||Infinity;
     const pb=Number(b.dataset.price)||Infinity;
     if(pa===pb)return 0;
     if(pa===Infinity)return 1;
     if(pb===Infinity)return -1;
     return value==='low'?pa-pb:pb-pa;
   });
   ordered.forEach(card=>results.append(card));
 }

 form.addEventListener('submit',e=>{e.preventDefault();filter()});
 form.addEventListener('input',()=>filter());
 form.addEventListener('change',()=>filter());
 document.querySelector('#clear')?.addEventListener('click',()=>{form.reset();applyScale('','');filter();(form.elements.namedItem('tipo') as HTMLSelectElement).focus()});
 sort.addEventListener('change',reorder);
 filter();
</script>
<script>
  import '../scripts/place-suggest';
</script></Layout>
